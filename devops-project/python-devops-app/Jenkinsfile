pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        NEXUS_REGISTRY = 'localhost:8083'
        NEXUS_IMAGE = 'localhost:8083/python-devops-app'

        AWS_REGION = 'ap-southeast-2'
        ECR_REGISTRY = '401106839558.dkr.ecr.ap-southeast-2.amazonaws.com'
        ECR_IMAGE = '401106839558.dkr.ecr.ap-southeast-2.amazonaws.com/python-devops-app'

        DOCKER_TAG = '1.0'
        K8S_MANIFEST = 'devops-project/python-devops-app/k8s/deployment.yaml'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'pwd'
                sh 'ls -la'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('devops-project/python-devops-app') {
                    sh '''
                        set -eu
                        python3 -m venv .venv
                        .venv/bin/python -m pip install --upgrade pip
                        .venv/bin/pip install -r requirements.txt
                        .venv/bin/pip install pytest
                    '''
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('devops-project/python-devops-app') {
                    sh '''
                        set -eu
                        .venv/bin/python -m pytest tests/ \
                            --junitxml=pytest-results.xml
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'devops-project/python-devops-app/pytest-results.xml'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('devops-project/python-devops-app') {
                    sh '''
                        set -eu
                        docker build -t "$NEXUS_IMAGE:$DOCKER_TAG" .
                    '''
                }
            }
        }

        stage('Push Image to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-docker-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        printf '%s' "$NEXUS_PASSWORD" |
                            docker login "$NEXUS_REGISTRY" \
                                --username "$NEXUS_USER" \
                                --password-stdin

                        docker push "$NEXUS_IMAGE:$DOCKER_TAG"
                        docker logout "$NEXUS_REGISTRY" || true
                    '''
                }
            }
        }

        stage('Login to Amazon ECR') {
            steps {
                sh '''
                    set -eu
                    aws ecr get-login-password \
                        --region "$AWS_REGION" |
                        docker login "$ECR_REGISTRY" \
                            --username AWS \
                            --password-stdin
                '''
            }
        }

        stage('Push Image to Amazon ECR') {
            steps {
                sh '''
                    set -eu
                    docker tag "$NEXUS_IMAGE:$DOCKER_TAG" "$ECR_IMAGE:$DOCKER_TAG"
                    docker push "$ECR_IMAGE:$DOCKER_TAG"
                '''
            }
        }

        stage('Update GitOps Manifest') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'github-credentials',
                        usernameVariable: 'GITHUB_USER',
                        passwordVariable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        test -f "$K8S_MANIFEST"

                        IMAGE_TAG="build-${BUILD_NUMBER}"

                        # Create and publish a unique image for this build.
                        docker tag "$NEXUS_IMAGE:$DOCKER_TAG" "$ECR_IMAGE:$IMAGE_TAG"
                        docker push "$ECR_IMAGE:$IMAGE_TAG"

                        # Load that exact image into the Kind cluster.
                        kind load docker-image "$ECR_IMAGE:$IMAGE_TAG" \
                            --name python-devops

                        # Update the image in the GitOps manifest.
                        sed -i -E \
                            "s|^[[:space:]]*image: .*python-devops-app:.*|          image: ${ECR_IMAGE}:${IMAGE_TAG}|" \
                            "$K8S_MANIFEST"

                        # Kind uses locally loaded images.
                        sed -i 's/imagePullPolicy: Always/imagePullPolicy: Never/' \
                            "$K8S_MANIFEST"

                        git config user.name "Jenkins CI"
                        git config user.email "jenkins@example.invalid"

                        git add "$K8S_MANIFEST"

                        if git diff --cached --quiet; then
                            echo "ERROR: No GitOps manifest change was created."
                            exit 1
                        fi

                        git commit -m "Update Python app image to ${IMAGE_TAG}"

                        AUTH_HEADER=$(printf '%s:%s' "$GITHUB_USER" "$GITHUB_TOKEN" |
                            base64 -w 0)

                        git -c http.extraheader="AUTHORIZATION: basic ${AUTH_HEADER}" \
                            push origin HEAD:main

                        unset AUTH_HEADER
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'CI successful: tests passed, image published, and GitOps manifest pushed. Argo CD will reconcile the new Git revision.'
        }
        failure {
            echo 'Pipeline failed. Check Console Output for the first failed stage.'
        }
        always {
            sh '''
                docker logout "$ECR_REGISTRY" || true
                docker logout "$NEXUS_REGISTRY" || true
            '''
        }
    }
}

