
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        SONAR_HOST_URL = 'http://localhost:9000'

        NEXUS_REGISTRY = 'localhost:8083'
        NEXUS_IMAGE = 'localhost:8083/python-devops-app'

        AWS_REGION = 'ap-southeast-2'
        ECR_REGISTRY = '401106839558.dkr.ecr.ap-southeast-2.amazonaws.com'
        ECR_IMAGE = '401106839558.dkr.ecr.ap-southeast-2.amazonaws.com/python-devops-app'

        DOCKER_TAG = '1.0'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'pwd'
                sh 'ls -la'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('devops-project/python-devops-app') {
                    sh '''
                        set -eu
                        python3 -m venv .venv
                        .venv/bin/python -m pip install --upgrade pip
                        .venv/bin/pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('devops-project/python-devops-app') {
                    sh '''
                        set -eu
                        .venv/bin/python -m pytest tests/ \
                            --junitxml=pytest-results.xml
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'devops-project/python-devops-app/pytest-results.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('devops-project/python-devops-app') {
                    withCredentials([
                        string(
                            credentialsId: 'sonar-token',
                            variable: 'SONAR_TOKEN'
                        )
                    ]) {
                        sh '''
                            set -eu
                            sonar-scanner \
                                -Dsonar.host.url="$SONAR_HOST_URL" \
                                -Dsonar.token="$SONAR_TOKEN"
                        '''
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('devops-project/python-devops-app') {
                    sh '''
                        set -eu
                        docker build \
                            -t "$NEXUS_IMAGE:$DOCKER_TAG" .
                    '''
                }
            }
        }

        stage('Push Image to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-docker-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        printf '%s' "$NEXUS_PASSWORD" |
                            docker login "$NEXUS_REGISTRY" \
                                --username "$NEXUS_USER" \
                                --password-stdin

                        docker push "$NEXUS_IMAGE:$DOCKER_TAG"

                        docker logout "$NEXUS_REGISTRY"
                    '''
                }
            }
        }

        stage('Login to Amazon ECR') {
            steps {
                sh '''
                    set -eu

                    aws ecr get-login-password \
                        --region "$AWS_REGION" |
                        docker login "$ECR_REGISTRY" \
                            --username AWS \
                            --password-stdin
                '''
            }
        }

        stage('Tag Image for ECR') {
            steps {
                sh '''
                    set -eu

                    docker tag \
                        "$NEXUS_IMAGE:$DOCKER_TAG" \
                        "$ECR_IMAGE:$DOCKER_TAG"
                '''
            }
        }

        stage('Push Image to Amazon ECR') {
            steps {
                sh '''
                    set -eu
                    docker push "$ECR_IMAGE:$DOCKER_TAG"
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline successful: tests, SonarQube, Docker build, Nexus push and Amazon ECR push.'
        }
        failure {
            echo 'Pipeline failed. Check Console Output for the failed stage.'
        }
        always {
            sh 'docker logout "$ECR_REGISTRY" || true'
        }
    }
}
