
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        SONAR_HOST_URL = 'http://localhost:9000'
        DOCKER_IMAGE = 'localhost:8083/python-devops-app'
        DOCKER_TAG = '1.0'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'pwd'
                sh 'ls -la'
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('devops-project/python-devops-app') {
                    sh '''
                        set -eu
                        python3 -m venv .venv
                        .venv/bin/python -m pip install --upgrade pip
                        .venv/bin/pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Unit Tests') {
            steps {
                dir('devops-project/python-devops-app') {
                    sh '''
                        set -eu
                        .venv/bin/python -m pytest tests/ \
                            --junitxml=pytest-results.xml
                    '''
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'devops-project/python-devops-app/pytest-results.xml'
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                dir('devops-project/python-devops-app') {
                    withCredentials([
                        string(
                            credentialsId: 'sonar-token',
                            variable: 'SONAR_TOKEN'
                        )
                    ]) {
                        sh '''
                            set -eu
                            sonar-scanner \
                                -Dsonar.host.url="$SONAR_HOST_URL" \
                                -Dsonar.token="$SONAR_TOKEN"
                        '''
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('devops-project/python-devops-app') {
                    sh '''
                        set -eu
                        docker build \
                            -t "$DOCKER_IMAGE:$DOCKER_TAG" .
                    '''
                }
            }
        }

        stage('Push Image to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'nexus-docker-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASSWORD'
                    )
                ]) {
                    sh '''
                        set +x
                        set -eu

                        printf '%s' "$NEXUS_PASSWORD" |
                            docker login localhost:8083 \
                                --username "$NEXUS_USER" \
                                --password-stdin

                        docker push "$DOCKER_IMAGE:$DOCKER_TAG"

                        docker logout localhost:8083
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }
        failure {
            echo 'Pipeline failed. Check the Jenkins console output.'
        }
    }
}
